
AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBXItems_Settings", "PBXItesm_Menu"
}

AddOptionMenu "PBXCore_Menu"
{
    StaticText	"--------- PBX Items Settings ---------", 1
    Option  "$PBXITEMS_MENU_ENABLE_TOOLTIPS", "PBXItems_SendTip", "OnOff","PBXCore_SendTip"
    SafeCommand "$PBXITEMS_MENU_RESET_SPAWNERS", "resetcvar PBXItems_powerupfilter; resetcvar PBXItems_itemFilter"
    SafeCommand "$PBXITEMS_MENU_RESET_PBXITEMS_TOOLTIPS", "resetcvar PBXItems_powerupHelpFlags; resetcvar PBXItems_itemHelpFlags"
    SafeCommand "$PBXITEMS_MENU_RESET_DURATIONS", "resetcvar PBXItems_goldinv_duration; resetcvar PBXItems_terror_duration; resetcvar PBXItems_infammo_duration; resetcvar PBXItems_timefreeze_duration; resetcvar PBXItems_adrenaline_duration"
    StaticText "$PBXItems_Version",orange
    StaticText " "
}

OptionMenu "PBXItesm_Menu"
{
    Title "$PBXItems_Settings"
	Class "PB_OptionMenu"
    Position	-48

    StaticText	"--------- General Settings ---------", 1
    Option "$PBXITEMS_START_WITH_SHOULDERCANNON", "pbxitems_startwithshouldercannon", "OnOff","PBXCore_GlorykillLoaded",1,1
    Option  "$PBXITEMS_MENU_ENABLE_TOOLTIPS", "PBXItems_SendTip", "OnOff","PBXCore_SendTip"
    SafeCommand "$PBXITEMS_MENU_RESET_SPAWNERS", "resetcvar PBXItems_powerupfilter; resetcvar PBXItems_itemFilter"
    SafeCommand "$PBXITEMS_MENU_RESET_PBXITEMS_TOOLTIPS", "resetcvar PBXItems_powerupHelpFlags; resetcvar PBXItems_itemHelpFlags"
    StaticText " "
    StaticText	"--------- PBX Items Settings ---------", 1
    Option  "$PBXITEMS_SHOULDCANNON_USEAMMO",       "PBXItems_shouldercannonuseammo", "OnOff"
    Slider "$PBXITEMS_FLAMEBELCHAMMOUSE",           "pbxitems_flamebelchammouse",     1, 500, 1
    Slider "$PBXITEMS_ICEBOMBAMMOUSE",              "pbxitems_icebombammouse",        1, 500, 1
    Slider "$PBXITEMS_JETPACKFUELUSE",              "pbxitems_jetpackfueluse",        1, 500, 1
    StaticText " "
    StaticText	"--------- PBX Items Duration Settings ---------", 1
    Slider "$PBXITEMS_GOLDINV_DURATION",             "pbxitems_goldinv_duration",        1, 500, 1
    Slider "$PBXITEMS_TERROR_DURATION",              "pbxitems_terror_duration",         1, 500, 1
    Slider "$PBXITEMS_INFAMMO_DURATION",             "pbxitems_infammo_duration",        1, 500, 1
    Slider "$PBXITEMS_TIMEFREEZE_DURATION",          "pbxitems_timefreeze_duration",     1, 500, 1
    Slider "$PBXITEMS_ADRENALINE_DURATION",          "pbxitems_adrenaline_duration",     1, 500, 1
    SafeCommand "$PBXITEMS_MENU_RESET_DURATIONS", "resetcvar PBXItems_goldinv_duration; resetcvar PBXItems_terror_duration; resetcvar PBXItems_infammo_duration; resetcvar PBXItems_timefreeze_duration; resetcvar PBXItems_adrenaline_duration"

    StaticText " "
    StaticText "$PBXItems_Version",orange
}

