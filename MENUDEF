
AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBXItems_Settings", "PBXItesm_Menu"
}

AddOptionMenu "PBXCore_Menu"
{
    StaticText	"--------- PBX Items Settings ---------", 1
    Option  "Enable Items Tooltips", "PBXItems_SendTip", "OnOff","PBXCore_SendTip"
    SafeCommand "Enable All PBX Items  Spawners", "resetcvar PBXItems_powerupfilter; resetcvar PBXItems_itemFilter"
    SafeCommand "Reset Item Tool Tips", "resetcvar PBXItems_powerupHelpFlags; resetcvar PBXItems_itemHelpFlags"
    StaticText "$PBXItems_Version",orange
    StaticText " "
}

OptionMenu "PBXItesm_Menu"
{
    Title "$PBXItems_Settings"
	Class "PB_OptionMenu"
    Position	-48

    StaticText	"--------- General Settings ---------", 1
    Option  "Enable Items Tooltips", "PBXItems_SendTip", "OnOff","PBXCore_SendTip"
    SafeCommand "Enable All PBX Items  Spawners", "resetcvar PBXItems_powerupfilter; resetcvar PBXItems_itemFilter"
    SafeCommand "Reset Item Tool Tips", "resetcvar PBXItems_powerupHelpFlags; resetcvar PBXItems_itemHelpFlags"


    /* Command "Reset PBX Armor Tips", "set PBXWeapons_WeaponHelpFlags 0; set PBXWeapons_UpgradeHelpFlags 0" */

    
    StaticText " "
    StaticText "$PBXItems_Version",orange
}

